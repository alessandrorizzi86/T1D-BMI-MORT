# T1 males

df_1 <- read.csv(list_files[4])

# Underweight
t1m_uw <- df_1 %>% select(c(starts_with("X_at1_"), tt)) %>% 
  rename(
    Cancer = X_at1_males_1, 
    CVD = X_at1_males_4,
    COPD = X_at1_males_3,
    Dementia = X_at1_males_5, 
    Other = X_at1_males_7, 
    Years = tt
  ) %>% pivot_longer(
    cols = c(Cancer:Other),
    names_to = "Cause", 
                     values_to = "CIF") %>% 
  ggplot(aes(x=Years, y= CIF, fill = Cause))+
  geom_area(position = "stack")+
  #theme_bw()+
  scale_color_manual(values = chosen_colours,
                     aesthetics = c("fill"))+
  theme(
    plot.title = element_text(size = 14),
    axis.text = element_text(size = 11),
    axis.title = element_text(size = 11),
    panel.background = element_rect(fill = "white"), 
    panel.grid.major = element_line(color = "grey", linetype = "dashed"), 
    axis.line = element_line(color = "black"), 
    plot.margin = margin(r= 6, b = 0, l = 0, t=2)
  )+
  coord_cartesian(xlim = c(0,15), ylim = c(0,0.35), expand = F)

