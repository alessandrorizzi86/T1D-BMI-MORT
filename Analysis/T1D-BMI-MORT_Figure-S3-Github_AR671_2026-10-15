################################################################################
## Useful Libraries
library(tidyverse)
library(ggplot2)
library(ggpubr)
library(cowplot)

################################################################################
# Set WD
setwd("folder")

################################################################################
# Colours
chosen_colours <- c( "green4", "orange2", "red3",  "blue3", "grey40")

# import the dataset
list_files <- files_list <- list.files(path = "files", pattern = "pattern", full.names = TRUE)
list_files

################################################################################
# Defining the labels for rows and colums 

col_labels <- c("Underweight", "Normal Weight", "Overweight", "Obese")
row_labels <- c("Males \n T1D", "Males \n No T1D", "Females \n T1D", "Females \n No T1D")

# Build label grobs
make_label <- function(txt, angle = 0) {
  ggdraw() + draw_label(txt, fontface = "bold", size = 14, angle = angle)
}

col_label_row <- plot_grid(
  plotlist = lapply(col_labels, make_label),
  nrow = 1, ncol = 4
)

row_label_col <- plot_grid(
  plotlist = lapply(row_labels, make_label),
  nrow = 4, ncol = 1
)

